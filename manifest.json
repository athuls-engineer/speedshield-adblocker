{
  "manifest_version": 3,
  "name": "SpeedShield - Ultra Fast Ad & Popup Blocker",
  "version": "1.0.0",
  "description": "High-speed Manifest V3 ad blocker. Blocks banners, video ads, trackers, and popups while accelerating website loading.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "SpeedShield Protection"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_ad_servers",
        "enabled": true,
        "path": "rules/ad-servers.json"
      },
      {
        "id": "ruleset_trackers",
        "enabled": true,
        "path": "rules/trackers.json"
      },
      {
        "id": "ruleset_popups",
        "enabled": true,
        "path": "rules/popups-redirects.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content/cosmetic-filter.css"],
      "js": ["content/cosmetic-engine.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/popup-defuser.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "alarms",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
